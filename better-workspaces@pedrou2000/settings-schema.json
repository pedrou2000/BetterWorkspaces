{
    "notionSection": {
        "type": "section",
        "description": "Notion integration"
    },
    "notionToken": {
        "type": "entry",
        "default": "",
        "description": "Notion integration token (secret_...)",
        "tooltip": "Create an internal integration at notion.so/my-integrations, share your Projects database with it, and paste the token here. It is moved to your system keyring and this field then only says so. Paste a new token to replace it; clear the field to forget it."
    },
    "notionDatabaseId": {
        "type": "entry",
        "default": "99d9eb7831fd41e9b42f966ebd9b16cb",
        "description": "Projects database ID",
        "tooltip": "The 32-char id of your Notion Projects database."
    },
    "syncIntervalSec": {
        "type": "spinbutton",
        "default": 300,
        "min": 30,
        "max": 3600,
        "step": 30,
        "units": "seconds",
        "description": "Background sync interval"
    },
    "syncNow": {
        "type": "button",
        "description": "Sync from Notion now",
        "callback": "onSyncNowClicked"
    },
    "behaviorSection": {
        "type": "section",
        "description": "Behaviour"
    },
    "autoCleanEmptyWorkspaces": {
        "type": "switch",
        "default": true,
        "description": "Remove a workspace when you leave it empty",
        "tooltip": "A project always keeps at least one workspace."
    },
    "appearanceSection": {
        "type": "section",
        "description": "Appearance"
    },
    "panelIconSize": {
        "type": "spinbutton",
        "default": 23,
        "min": 12,
        "max": 48,
        "step": 1,
        "units": "px",
        "description": "Panel icon size"
    },
    "projectSpacing": {
        "type": "spinbutton",
        "default": 2,
        "min": 0,
        "max": 16,
        "step": 1,
        "units": "px",
        "description": "Space between project icons"
    },
    "showKeyHints": {
        "type": "switch",
        "default": true,
        "description": "Show the key hints and Close button in the project navigator",
        "tooltip": "The controls at the bottom of the Super+P panel. The small × next to the hints also turns this off. Esc closes the panel either way."
    },
    "dialogStyle": {
        "type": "combobox",
        "default": "notion",
        "options": {
            "Notion-like": "notion",
            "Classic (the original)": "classic"
        },
        "description": "Look of the dialogs and overlays",
        "tooltip": "The project navigator, the new-project dialog, notices, the Super+Tab switcher and the on-screen message. The panel bar is not affected. Applies the next time each one opens."
    },
    "surfaceTone": {
        "type": "combobox",
        "default": "gray",
        "options": {
            "Gray (Notion's menus)": "gray",
            "Darker (Notion's page)": "darker",
            "See-through": "glass",
            "Blue tint": "blue"
        },
        "dependency": "dialogStyle=notion",
        "description": "Background of the Notion-like look",
        "tooltip": "Applies the next time each dialog or overlay opens."
    },
    "notionStyleEmoji": {
        "type": "switch",
        "default": true,
        "description": "Draw emoji icons the way Notion does",
        "tooltip": "Uses Twemoji images (downloaded once and cached) instead of the system emoji font."
    },
    "emojiZoom": {
        "type": "spinbutton",
        "default": 85,
        "min": 50,
        "max": 200,
        "step": 5,
        "units": "%",
        "description": "Emoji icon size",
        "tooltip": "How large emoji are drawn inside their icon box, compared with image icons. Visual only: the spacing between icons doesn't change. Notion-style emoji fill the box at 100% and stop growing there; lower it until they match your other icons."
    },
    "dotSize": {
        "type": "spinbutton",
        "default": 15,
        "min": 8,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Active workspace dot size"
    },
    "dotSizeSmall": {
        "type": "spinbutton",
        "default": 15,
        "min": 8,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Other workspace dot size"
    },
    "keybindingsSection": {
        "type": "section",
        "description": "Keyboard shortcuts"
    },
    "kbSchemeVersion": {
        "type": "generic",
        "default": 0
    },
    "kbWorkspacePrev": {
        "type": "keybinding",
        "default": "<Super>Left",
        "description": "Previous workspace (within project)"
    },
    "kbWorkspaceNext": {
        "type": "keybinding",
        "default": "<Super>Right",
        "description": "Next workspace (within project)"
    },
    "kbProjectPrev": {
        "type": "keybinding",
        "default": "<Super><Alt>Left",
        "description": "Previous project (list order)"
    },
    "kbProjectNext": {
        "type": "keybinding",
        "default": "<Super><Alt>Right",
        "description": "Next project (list order)"
    },
    "kbMoveWindowPrev": {
        "type": "keybinding",
        "default": "<Primary><Super>Left",
        "description": "Move window to previous workspace"
    },
    "kbMoveWindowNext": {
        "type": "keybinding",
        "default": "<Primary><Super>Right",
        "description": "Move window to next workspace"
    },
    "kbMoveWindowProjectPrev": {
        "type": "keybinding",
        "default": "<Primary><Super><Alt>Left",
        "description": "Move window to previous project (list order)"
    },
    "kbMoveWindowProjectNext": {
        "type": "keybinding",
        "default": "<Primary><Super><Alt>Right",
        "description": "Move window to next project (list order)"
    },
    "kbSwitcher": {
        "type": "keybinding",
        "default": "<Super>Tab",
        "description": "Project switcher (MRU)"
    },
    "kbOpenNotion": {
        "type": "keybinding",
        "default": "<Super>n",
        "description": "Open active project's Notion page"
    },
    "kbTogglePanel": {
        "type": "keybinding",
        "default": "<Super>p",
        "description": "Open the project toggle panel"
    },
    "kbRemoveProject": {
        "type": "keybinding",
        "default": "<Super>q",
        "description": "Remove the current project from workspaces (closes its windows)"
    },
    "kbDeleteProject": {
        "type": "keybinding",
        "default": "<Shift><Super>q",
        "description": "Delete the current project in Notion (asks first)"
    },
    "kbNewSubProject": {
        "type": "keybinding",
        "default": "<Super>s",
        "description": "New sub-project of the current project (asks for a name)"
    },
    "kbNewProject": {
        "type": "keybinding",
        "default": "<Super>a",
        "description": "New project (asks for a name)"
    },
    "kbSyncNow": {
        "type": "keybinding",
        "default": "<Super>r",
        "description": "Sync with Notion now"
    },
    "wmSection": {
        "type": "section",
        "description": "Window management (Cinnamon actions, reassigned)"
    },
    "kbTileLeft": {
        "type": "keybinding",
        "default": "<Super><Shift>Left",
        "description": "Tile window left"
    },
    "kbTileRight": {
        "type": "keybinding",
        "default": "<Super><Shift>Right",
        "description": "Tile window right"
    },
    "kbTileUp": {
        "type": "keybinding",
        "default": "<Super><Shift>Up",
        "description": "Tile window up"
    },
    "kbTileDown": {
        "type": "keybinding",
        "default": "<Super><Shift>Down",
        "description": "Tile window down"
    },
    "kbMaximize": {
        "type": "keybinding",
        "default": "<Alt>a",
        "description": "Maximize window"
    },
    "kbMinimize": {
        "type": "keybinding",
        "default": "<Alt>s",
        "description": "Minimize window"
    }
}
